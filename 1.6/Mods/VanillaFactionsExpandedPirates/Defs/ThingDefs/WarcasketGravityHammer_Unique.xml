<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Warcasket gravity hammer. VFE Pirates (compat load root, see LoadFolders.xml: exists only with VFEP
       active, so no MayRequire). Industrial, not stuffable, and
       quality-less like its VFEP base (see the comps note).
       Tools: a VFEP_GravityHammerAttack head (Blunt damage plus VEF's 3-cell push-back) and
       a Poke handle, slow 3s swing, so it takes the warhammer's three categories (Melee, Blunt,
       Heavy). Studded and Flanged list the head's capacity explicitly (see their headers); no trait
       converts Blunt damage, so the push-back survives every roll.
       Warcasket-only: the inherited VEF HeavyWeapon extension makes VEF's CanEquip postfix refuse any
       pawn without a warcasket, which is wanted. Pawn generation can't hand one out
       (generateAllowChance 0); the Warband quest and tribal traders are kept off it by
       UniqueWeaponDefs.TribalTechCap, while the other reward pools take it by design.
       Not stuffable, so there is no material tint: colour two (the green-masked body) falls through
       UniqueMeleeWeapon.DrawColorTwo to graphicData.colorTwo, which is therefore the body placeholder
       colour, and a ForcedColorTwoExtension trait still replaces it.
       The mask's red|green edges are feathered, so the pair draws with UMW_CutoutComplexMix (the mix
       shader; its ShaderTypeDefs and asset bundles live in this compat root and nowhere else, so the
       other uniques stay on vanilla CutoutComplex).
       Drawn as itself on the floor, like every other unique, not as VFEP's boxed crate: the inherited
       VEF FloorGraphicExtension is inert here, since only VEF's ThingWithFloorGraphic reads it and our
       thingClass replaces that class. A purple-tinted crate was tried and dropped (2026-09): it hid
       the unique's art and colours on the ground, and it needed a draw path of its own (a Graphic
       override feeds the UI icons too, and the print path swaps in the static-atlas material, which
       VFEP_Box_* atlases mask-less) to carry a boxed-cargo fiction that fits VFEP's
       construction-built weapons, not reward-only uniques. -->
  <ThingDef ParentName="VFEP_WarcasketMeleeWeapon_GravityHammer">
    <defName>UMW_WarcasketGravityHammer_Unique</defName>
    <label>unique warcasket gravity hammer</label>
    <description>A warcasket gravity hammer bearing the marks of a master's hand. No two are forged alike.</description>
    <thingClass>UniqueMeleeWeapons.UniqueMeleeWeapon</thingClass>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/UniqueWeapons/WarcasketGravityHammer</texPath>
      <graphicClass>UniqueMeleeWeapons.Graphic_RandomComplex</graphicClass>
      <shaderType>UMW_CutoutComplexMix</shaderType> <!-- mixes the two tints for this art's feathered red|green mask edges; see ../ShaderTypeDefs -->
      <colorTwo>(91,94,96)</colorTwo> <!-- #5B5E60 body placeholder; see header -->
    </graphicData>
    <generateAllowChance>0</generateAllowChance>
    <possessionCount>0</possessionCount>
    <tradeability>Sellable</tradeability>
    <!-- Inherit="False" also drops VFEP's Warcasket tag. -->
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
      <li>UniqueWeapon</li>
      <li>UMW_UniqueMelee</li>
    </thingSetMakerTags>
    <recipeMaker Inherit="False" IsNull="True" />
    <thingCategories Inherit="False">
      <li>WeaponsUnique</li>
    </thingCategories>
    <descriptionHyperlinks>
      <ThingDef>VFEP_WarcasketMeleeWeapon_GravityHammer</ThingDef>
    </descriptionHyperlinks>
    <!-- Can't inherit comps: CompEquippableAbilityReloadable must replace CompEquippable
         (one CompEquippable-derived comp allowed). Otherwise mirrors the VFEP base's comps (vanilla
         BaseMeleeWeapon: Forbiddable, Equippable, Styleable), which carry NO CompQuality: VFEP's
         warcasket weapons have no quality tier, so neither does the unique. CompUniqueWeapon.PostPostMake
         null-checks the comp and skips its Super roll (decompile-verified), so MarketValue is base plus
         trait offsets. CompArt stays even so: every unique bears an inscription (the eight
         quality-bearing ones get it because the Super roll always clears minQualityForArtistic), and
         with no CompQuality nothing would call InitializeArt, so UniqueMeleeWeapon.PostPostMake does.
         No minQualityForArtistic: CanShowArt is unconditionally true without a CompQuality. If
         BaseWeapon/BaseMeleeWeapon comps change in a vanilla update, replicate here. -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable" /> <!-- props populated by traits -->
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
      </li>
      <li Class="CompProperties_UniqueWeapon">
        <weaponCategories>
          <li>UMW_Melee</li>
          <li>UMW_Blunt</li>
          <li>UMW_Heavy</li>
        </weaponCategories>
        <namerLabels>
          <li>hammer</li>
          <li>maul</li>
          <li>head</li>
          <li>gravity hammer</li>
        </namerLabels>
      </li>
    </comps>
    <!-- No modExtensions of our own. The inherited VEF HeavyWeapon (the warcasket-only equip gate)
         and FloorGraphicExtension (inert, see header) stay. -->
  </ThingDef>

</Defs>
