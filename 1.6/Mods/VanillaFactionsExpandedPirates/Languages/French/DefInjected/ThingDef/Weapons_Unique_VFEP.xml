<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- UMW_WarcasketBroadsword_Unique and UMW_WarcasketGravityHammer_Unique are declared in this
       VFE Pirates compat load root (1.6/Mods/VanillaFactionsExpandedPirates/Defs/ThingDefs/) and carry no
       MayRequire of their own. MayRequire is honored on defs but IGNORED on
       DefInjected entries, so these injections live in this LoadFolders-gated
       compat root (1.6/Mods/VanillaFactionsExpandedPirates loads only when VFE Pirates is active) rather than
       the main 1.6/Languages/French/DefInjected/ThingDef/Weapons_Unique.xml, which
       would error on startup for players without VFE Pirates. Style conventions for
       these entries are documented in that file's header comment.
       "Warcasket" is rendered "sarcophage" (m.), the family term shared with the sibling Warcasket
       mods; the weapon labels are coined (no community text readable): "<weapon> unique de sarcophage",
       with "unique" kept beside the weapon noun so it cannot read as qualifying the sarcophage. -->

  <!-- EN: unique warcasket broadsword -->
  <UMW_WarcasketBroadsword_Unique.label>épée large unique de sarcophage</UMW_WarcasketBroadsword_Unique.label>

  <!-- EN: A warcasket broadsword bearing the marks of a master's hand. No two are forged alike. -->
  <UMW_WarcasketBroadsword_Unique.description>Une épée large de sarcophage portant la marque de la main d'un maître. Il n'en existe pas deux forgées à l'identique.</UMW_WarcasketBroadsword_Unique.description>

