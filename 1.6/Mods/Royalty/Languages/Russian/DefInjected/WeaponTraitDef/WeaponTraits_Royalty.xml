<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- UMW_ZeusHeaded, UMW_PlasmaCored, UMW_Monomolecular, UMW_EltexPlated,
       UMW_EltexFitted and UMW_LeadLined are declared in this
       Royalty compat load root (1.6/Mods/Royalty/Defs/WeaponTraitDefs/ and its Melee/ folder) and carry
       no MayRequire of their own. MayRequire is honored on defs but
       IGNORED on DefInjected entries, so these injections live in this
       LoadFolders-gated compat root (1.6/Mods/Royalty loads only when Royalty is
       active) rather than the main
       1.6/Languages/Russian/DefInjected/WeaponTraitDef/WeaponTraits.xml, which would
       error on startup for players without Royalty. Style conventions for these
       entries are documented in that file's header comment. -->

  <!-- EN: monomolecular -->
  <UMW_Monomolecular.label>мономолекулярное</UMW_Monomolecular.label>

  <!-- EN: The edge is honed to a single molecule and held there by a lattice of mechanites. It parts armor and bone as though they were not there. -->
  <UMW_Monomolecular.description>Лезвие сведено до толщины в одну молекулу, и решётка механитов удерживает эту кромку. Оно рассекает броню и кость, словно их нет.</UMW_Monomolecular.description>

  <!-- EN: mono-edged -->
  <UMW_Monomolecular.traitAdjectives.0>мономолекулярный</UMW_Monomolecular.traitAdjectives.0>

  <!-- EN: crystalline -->
  <UMW_Monomolecular.traitAdjectives.1>кристаллический</UMW_Monomolecular.traitAdjectives.1>

  <!-- EN: honed -->
  <UMW_Monomolecular.traitAdjectives.2>отточенный</UMW_Monomolecular.traitAdjectives.2>


  <!-- EN: plasma-cored -->
  <UMW_PlasmaCored.label>плазменный сердечник</UMW_PlasmaCored.label>

  <!-- EN: The core of the blade channels a sheath of plasma, held in place by an energy field and released into the wounds it cuts. It sears flesh and sometimes ignites the target. -->
  <UMW_PlasmaCored.description>По сердечнику клинка проходит плазменная оболочка: энергетическое поле удерживает её и высвобождает в наносимые раны. Плазма обжигает плоть и порой поджигает цель.</UMW_PlasmaCored.description>

  <!-- EN: plasma-cored -->
  <UMW_PlasmaCored.traitAdjectives.0>плазменный</UMW_PlasmaCored.traitAdjectives.0>

  <!-- EN: burning -->
  <UMW_PlasmaCored.traitAdjectives.1>пылающий</UMW_PlasmaCored.traitAdjectives.1>

  <!-- EN: searing -->
  <UMW_PlasmaCored.traitAdjectives.2>обжигающий</UMW_PlasmaCored.traitAdjectives.2>

  <!-- EN: fiery -->
  <UMW_PlasmaCored.traitAdjectives.3>огненный</UMW_PlasmaCored.traitAdjectives.3>

  <!-- EN: incandescent -->
  <UMW_PlasmaCored.traitAdjectives.4>раскалённый</UMW_PlasmaCored.traitAdjectives.4>


  <!-- EN: zeus-headed -->
  <UMW_ZeusHeaded.label>электробоёк</UMW_ZeusHeaded.label>

  <!-- EN: The head houses a miniaturized zeus-cell that releases an electromagnetic discharge on impact, temporarily disabling electronics and mechanoids. -->
  <UMW_ZeusHeaded.description>В боевой части скрыт миниатюрный электромагнитный конденсатор, как у электромолота: при ударе он испускает электромагнитный разряд, временно выводящий из строя электронику и механоидов.</UMW_ZeusHeaded.description>

  <!-- EN: zeus-headed -->
  <UMW_ZeusHeaded.traitAdjectives.0>зевсов</UMW_ZeusHeaded.traitAdjectives.0>

  <!-- EN: thunderous -->
  <UMW_ZeusHeaded.traitAdjectives.1>громоподобный</UMW_ZeusHeaded.traitAdjectives.1>

  <!-- EN: electric -->
  <UMW_ZeusHeaded.traitAdjectives.2>электрический</UMW_ZeusHeaded.traitAdjectives.2>

  <!-- EN: shocking -->
  <UMW_ZeusHeaded.traitAdjectives.3>шокирующий</UMW_ZeusHeaded.traitAdjectives.3>


  <!-- EN: eltex-plated -->
  <UMW_EltexPlated.label>обшивка из эльтекса</UMW_EltexPlated.label>

  <!-- EN: The body is plated in eltex, a psychically resonant alloy, under a pale sheen. It sharpens the wielder's psychic sensitivity and bleeds away neural heat. -->
  <UMW_EltexPlated.description>Корпус обшит эльтексом, психически резонирующим сплавом, и покрыт бледным глянцем. Он обостряет психочувствительность владельца и рассеивает нейроперегрев.</UMW_EltexPlated.description>

  <!-- EN: eltex-plated -->
  <UMW_EltexPlated.traitAdjectives.0>обшитый эльтексом</UMW_EltexPlated.traitAdjectives.0>

  <!-- EN: pale-sheened -->
  <UMW_EltexPlated.traitAdjectives.1>бледно-блестящий</UMW_EltexPlated.traitAdjectives.1>

  <!-- EN: resonant -->
  <UMW_EltexPlated.traitAdjectives.2>резонирующий</UMW_EltexPlated.traitAdjectives.2>


  <!-- EN: eltex-fitted -->
  <UMW_EltexFitted.label>отделка из эльтекса</UMW_EltexFitted.label>

  <!-- EN: The grip, guard and pommel are fitted in eltex, cut dark and left unpolished. It widens the wielder's neural heat limit and amplifies their psychic sensitivity. -->
  <UMW_EltexFitted.description>Рукоять, гарда и навершие отделаны эльтексом, тёмным и неполированным. Он расширяет порог нейроперегрева владельца и усиливает его психочувствительность.</UMW_EltexFitted.description>

  <!-- EN: eltex-fitted -->
  <UMW_EltexFitted.traitAdjectives.0>отделанный эльтексом</UMW_EltexFitted.traitAdjectives.0>

  <!-- EN: eltex-furnished -->
  <UMW_EltexFitted.traitAdjectives.1>оснащённый эльтексом</UMW_EltexFitted.traitAdjectives.1>

  <!-- EN: resonant -->
  <UMW_EltexFitted.traitAdjectives.2>резонирующий</UMW_EltexFitted.traitAdjectives.2>


  <!-- EN: lead-lined -->
  <UMW_LeadLined.label>свинцовая подкладка</UMW_LeadLined.label>

  <!-- EN: The tang and fittings are lined with lead, which deadens the wielder's psychic sensitivity for better and for worse. The lining adds weight and slows the swing. -->
  <UMW_LeadLined.description>Хвостовик и фурнитура подбиты свинцом, который приглушает психочувствительность владельца, и к лучшему, и к худшему. Подкладка добавляет вес и замедляет взмах.</UMW_LeadLined.description>

  <!-- EN: lead-lined -->
  <UMW_LeadLined.traitAdjectives.0>подбитый свинцом</UMW_LeadLined.traitAdjectives.0>

  <!-- EN: leaden -->
  <UMW_LeadLined.traitAdjectives.1>свинцовый</UMW_LeadLined.traitAdjectives.1>

  <!-- EN: deadened -->
  <UMW_LeadLined.traitAdjectives.2>приглушённый</UMW_LeadLined.traitAdjectives.2>

</LanguageData>
