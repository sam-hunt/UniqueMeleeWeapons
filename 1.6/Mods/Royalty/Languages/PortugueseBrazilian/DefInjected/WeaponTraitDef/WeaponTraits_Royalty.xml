<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- UMW_ZeusHeaded, UMW_PlasmaCored, UMW_Monomolecular, UMW_EltexPlated, UMW_EltexFitted and UMW_LeadLined are declared in this
       Royalty compat load root (1.6/Mods/Royalty/Defs/WeaponTraitDefs/) and carry
       no MayRequire of their own. MayRequire is honored on defs but
       IGNORED on DefInjected entries, so these injections live in this
       LoadFolders-gated compat root (1.6/Mods/Royalty loads only when Royalty is
       active) rather than the main
       1.6/Languages/PortugueseBrazilian/DefInjected/WeaponTraitDef/WeaponTraits.xml, which would
       error on startup for players without Royalty. Style conventions for these
       entries are documented in that file's header comment. -->

  <!-- EN: monomolecular -->
  <UMW_Monomolecular.label>monomolecular</UMW_Monomolecular.label>

  <!-- EN: The edge is honed to a single molecule and held there by a lattice of mechanites. It parts armor and bone as though they were not there. -->
  <UMW_Monomolecular.description>A lâmina é afiada até a espessura de uma única molécula e mantida assim por uma malha de mecanitos. Ela separa armadura e osso como se não estivessem ali.</UMW_Monomolecular.description>

  <!-- EN: mono-edged -->
  <UMW_Monomolecular.traitAdjectives.0>monomolecular</UMW_Monomolecular.traitAdjectives.0>

  <!-- EN: crystalline -->
  <UMW_Monomolecular.traitAdjectives.1>impalpável</UMW_Monomolecular.traitAdjectives.1>

  <!-- EN: honed -->
  <UMW_Monomolecular.traitAdjectives.2>sutil</UMW_Monomolecular.traitAdjectives.2>


  <!-- EN: plasma-cored -->
  <UMW_PlasmaCored.label>núcleo de plasma</UMW_PlasmaCored.label>

  <!-- EN: The core of the blade channels a sheath of plasma, held in place by an energy field and released into the wounds it cuts. It sears flesh and sometimes ignites the target. -->
  <UMW_PlasmaCored.description>O núcleo da lâmina canaliza um envoltório de plasma, mantido no lugar por um campo de energia e liberado nas feridas que ela abre. Queima a carne e às vezes incendeia o alvo.</UMW_PlasmaCored.description>

  <!-- EN: plasma-cored -->
  <UMW_PlasmaCored.traitAdjectives.0>incandescente</UMW_PlasmaCored.traitAdjectives.0>

  <!-- EN: burning -->
  <UMW_PlasmaCored.traitAdjectives.1>ardente</UMW_PlasmaCored.traitAdjectives.1>

  <!-- EN: searing -->
  <UMW_PlasmaCored.traitAdjectives.2>candente</UMW_PlasmaCored.traitAdjectives.2>

  <!-- EN: fiery -->
  <UMW_PlasmaCored.traitAdjectives.3>flamejante</UMW_PlasmaCored.traitAdjectives.3>

  <!-- EN: incandescent -->
  <UMW_PlasmaCored.traitAdjectives.4>fulgurante</UMW_PlasmaCored.traitAdjectives.4>


  <!-- EN: zeus-headed -->
  <UMW_ZeusHeaded.label>cabeça de zeus</UMW_ZeusHeaded.label>

  <!-- EN: The head houses a miniaturized zeus-cell that releases an electromagnetic discharge on impact, temporarily disabling electronics and mechanoids. -->
  <UMW_ZeusHeaded.description>A cabeça abriga uma célula de zeus miniaturizada que libera uma descarga eletromagnética no impacto, desativando temporariamente os sistemas eletrônicos e os mecanoides.</UMW_ZeusHeaded.description>

  <!-- EN: zeus-headed -->
  <UMW_ZeusHeaded.traitAdjectives.0>fulminante</UMW_ZeusHeaded.traitAdjectives.0>

  <!-- EN: thunderous -->
  <UMW_ZeusHeaded.traitAdjectives.1>trovejante</UMW_ZeusHeaded.traitAdjectives.1>

  <!-- EN: electric -->
  <UMW_ZeusHeaded.traitAdjectives.2>eletrizante</UMW_ZeusHeaded.traitAdjectives.2>

  <!-- EN: shocking -->
  <UMW_ZeusHeaded.traitAdjectives.3>faiscante</UMW_ZeusHeaded.traitAdjectives.3>


  <!-- EN: eltex-plated -->
  <UMW_EltexPlated.label>placas de eltex</UMW_EltexPlated.label>

  <!-- EN: The body is plated in pale eltex. The psychic focusing material enhances the wielder's psychic sensitivity and helps dissipate neural heat. -->
  <UMW_EltexPlated.description>O corpo é revestido de eltex pálido. O material de concentração psíquica aumenta a sensibilidade psíquica do usuário e ajuda a dissipar o calor neural.</UMW_EltexPlated.description>

  <!-- EN: eltex-plated -->
  <UMW_EltexPlated.traitAdjectives.0>eltex</UMW_EltexPlated.traitAdjectives.0>

  <!-- EN: pale-sheened -->
  <UMW_EltexPlated.traitAdjectives.1>cintilante</UMW_EltexPlated.traitAdjectives.1>

  <!-- EN: resonant -->
  <UMW_EltexPlated.traitAdjectives.2>ressonante</UMW_EltexPlated.traitAdjectives.2>


  <!-- EN: eltex-fitted -->
  <UMW_EltexFitted.label>ferragens de eltex</UMW_EltexFitted.label>

  <!-- EN: The grip and fittings are made of dark, unpolished eltex. They enhance the wielder's psychic sensitivity and increase their neural heat limit. -->
  <UMW_EltexFitted.description>A empunhadura e as ferragens são feitas de eltex escuro e sem polimento. Elas aumentam a sensibilidade psíquica do usuário e seu limite de calor neural.</UMW_EltexFitted.description>

  <!-- EN: eltex-fitted -->
  <UMW_EltexFitted.traitAdjectives.0>eltex</UMW_EltexFitted.traitAdjectives.0>

  <!-- EN: eltex-furnished -->
  <UMW_EltexFitted.traitAdjectives.1>vibrante</UMW_EltexFitted.traitAdjectives.1>

  <!-- EN: resonant -->
  <UMW_EltexFitted.traitAdjectives.2>ressonante</UMW_EltexFitted.traitAdjectives.2>


  <!-- EN: lead-lined -->
  <UMW_LeadLined.label>forro de chumbo</UMW_LeadLined.label>

  <!-- EN: The grip is lined with lead, which suppresses the wielder's psychic sensitivity. The extra weight slows the swing. -->
  <UMW_LeadLined.description>A empunhadura é forrada de chumbo, que diminui a sensibilidade psíquica do usuário. O peso extra deixa o golpe mais lento.</UMW_LeadLined.description>

  <!-- EN: lead-lined -->
  <UMW_LeadLined.traitAdjectives.0>isolante</UMW_LeadLined.traitAdjectives.0>

  <!-- EN: leaden -->
  <UMW_LeadLined.traitAdjectives.1>grave</UMW_LeadLined.traitAdjectives.1>

  <!-- EN: deadened -->
  <UMW_LeadLined.traitAdjectives.2>inerte</UMW_LeadLined.traitAdjectives.2>

</LanguageData>
