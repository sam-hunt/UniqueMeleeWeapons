  <!-- EN: resonant -->
  <UMW_EltexFitted.traitAdjectives.2>resonant</UMW_EltexFitted.traitAdjectives.2>


  <!-- EN: lead-lined -->
  <UMW_LeadLined.label>bleiverkleidet</UMW_LeadLined.label>

  <!-- EN: The grip is lined with lead, which suppresses the wielder's psychic sensitivity. The extra weight slows the swing. -->
  <UMW_LeadLined.description>Der Griff ist mit Blei ausgekleidet, das die mentale Sensibilität des Trägers unterdrückt. Das zusätzliche Gewicht verlangsamt den Schwung.</UMW_LeadLined.description>

  <!-- EN: lead-lined -->
  <UMW_LeadLined.traitAdjectives.0>bleiverkleidet</UMW_LeadLined.traitAdjectives.0>

