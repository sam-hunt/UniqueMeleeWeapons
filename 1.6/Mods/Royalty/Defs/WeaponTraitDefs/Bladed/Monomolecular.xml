<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UMW_Bladed. Edge — a mechanite-sustained mono-molecular edge that shears through armor: a
       reference to Royalty's monosword tech, so the def lives in the Royalty compat load root
       (see LoadFolders.xml; the same gate the Axe/Warhammer uniques use) together with its
       UMW_MonoWhite ColorDef — the trait only rolls when the DLC that owns the tech is present.
       No MayRequire needed - the folder only loads when Royalty is active, and its DefInjected
       sibling can't gate any other way.
       INTENT: "this unique has a monosword's edge." Realised via MeleeToolModExtension's QUALITY
       floor on the Cut AND Stab tools: 0.9 is the monosword's own tool armorPenetration (Royalty
       MeleeUltratech.xml, both edge and point), and vanilla scales an explicit tool AP by the
       weapon's MeleeWeapon_DamageMultiplier quality factor, so the floor is multiplied by the same
       factor at swing time (Verb_MeleeAttack_ToolMods_Patch): 0.9 Normal, 0.99 Good, 1.31
       Masterwork, 1.49 Legendary, exactly a monosword of that quality. Uniques roll Masterwork or
       better (QualityGenerator.Super), so in play this reads 1.31 to 1.49 and outclasses every
       vanilla armor value outright. HISTORY: shipped through 1.x as a FLAT floor of 0.97, "slightly
       worse than the monosword's 0.99", which quoted a Good monosword without saying so; being
       flat and applied after quality scaling (no unique's own Cut/Stab AP reaches it: a Legendary
       plasteel longsword edge computes to ~0.63, a Legendary spear point ~0.83), every roll sat at
       0.97 regardless of quality. Replaced 2026-11 so quality matters for the premium trait and the
       def holds the monosword's literal value rather than a hand-tuned number; the Combat Extended
       root patches the CE-unit equivalents (18 / 25 mm RHA) onto this same entry. Pure AP, no
       damage change — AP is wasted on unarmored targets but devastating vs plate/mechs; the top rung
       of the ladder ArmorSpike (0.6) and Flanged (0.45) sit on. Flashy, so rarer (commonality 0.5).
       Forces the
       pure-white UMW_MonoWhite onto COLOUR TWO (the body) via ForcedColorTwoExtension, so it tags
       BodyColor (its own one-per-weapon family) — being on a different mask channel than the
       Color-tagged inlays, it can co-occur with a Gold/Jade inlay. The Edge tag keeps it mutually
       exclusive with Razored/Serrated. Additionally suppressed by the allowUltratechTraits setting,
       which medieval-only runs turn off (Patches/CompUniqueWeapon_UltratechTraits_Patch.cs).
       Under Combat Extended the floor is restated as the monosword's CE tools, Cut 18 / Stab
       25 mm RHA at Normal (1.6/Mods/CombatExtended/Patches/WeaponTraits_CE.xml). -->
  <WeaponTraitDef>
    <defName>UMW_Monomolecular</defName>
    <label>monomolecular</label>
    <description>The edge is honed to a single molecule and held there by a lattice of mechanites. It parts armor and bone as though they were not there.</description>
    <commonality>0.5</commonality>
    <weaponCategory>UMW_Bladed</weaponCategory>
    <exclusionTags>
      <li>Edge</li>
      <li>BodyColor</li>
    </exclusionTags>
    <statOffsets>
      <MarketValue>120</MarketValue> <!-- premium tier, cf. ChargeCapacitor -->
    </statOffsets>
    <traitAdjectives>
      <li>mono-edged</li>
      <li>crystalline</li>
      <li>honed</li>
    </traitAdjectives>
    <modExtensions>
      <li Class="UniqueMeleeWeapons.MeleeToolModExtension">
        <mods>
          <li>
            <capacities>
              <li>Cut</li>
              <li>Stab</li>
            </capacities>
            <armorPenetrationQualityFloor>0.9</armorPenetrationQualityFloor> <!-- the monosword's tool AP at Normal; quality-scaled at swing time, see header -->

          </li>
        </mods>
      </li>
      <li Class="UniqueMeleeWeapons.ForcedColorTwoExtension">
        <color>UMW_MonoWhite</color>
      </li>
    </modExtensions>
  </WeaponTraitDef>

</Defs>
