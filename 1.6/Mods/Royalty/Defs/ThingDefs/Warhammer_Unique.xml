<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Warhammer. Royalty, Medieval. Blunt, slow 2.6s swing -> Blunt + Heavy. Lives in the
       Royalty compat load root (see LoadFolders.xml); no MayRequire needed since the folder
       only loads when Royalty is active, and its DefInjected sibling can't gate any other way. -->
  <ThingDef ParentName="MeleeWeapon_Warhammer">
    <defName>UMW_Warhammer_Unique</defName>
    <label>unique warhammer</label>
    <description>A warhammer bearing the marks of a master's hand. No two are forged alike.</description>
    <thingClass>UniqueMeleeWeapons.UniqueMeleeWeapon</thingClass>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/UniqueWeapons/Warhammer</texPath>
      <graphicClass>UniqueMeleeWeapons.Graphic_RandomComplex</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <generateAllowChance>0</generateAllowChance>
    <possessionCount>0</possessionCount>
    <tradeability>Sellable</tradeability>
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
      <li>UniqueWeapon</li>
      <li>UMW_UniqueMelee</li>
    </thingSetMakerTags>
    <recipeMaker Inherit="False" IsNull="True" />
    <thingCategories Inherit="False">
      <li>WeaponsUnique</li>
    </thingCategories>
    <descriptionHyperlinks>
      <ThingDef>MeleeWeapon_Warhammer</ThingDef>
    </descriptionHyperlinks>
    <!-- Can't inherit comps: CompEquippableAbilityReloadable must replace CompEquippable
         (one CompEquippable-derived comp allowed). If BaseWeapon/BaseMeleeWeapon_*_Quality
         comps change in a vanilla update, replicate here. -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable" /> <!-- props populated by traits -->
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="CompProperties_UniqueWeapon">
        <weaponCategories>
          <li>UMW_Melee</li>
          <li>UMW_Blunt</li>
          <li>UMW_Heavy</li>
        </weaponCategories>
        <namerLabels>
          <li>warhammer</li>
          <li>hammer</li>
          <li>maul</li>
          <li>head</li>
        </namerLabels>
      </li>
    </comps>
  </ThingDef>

</Defs>
