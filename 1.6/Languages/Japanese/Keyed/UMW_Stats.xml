<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Info card: per-trait effect lines under vanilla's "Weapon traits" entry, one " - ..." line
       each. Keep them short — the entry lists up to three traits at once. -->
  <!-- Per-tool damage / armor penetration. {0} is a tool capacity ("cut", "cut and stab") or the
       UMW_TraitStat_AllTools word when the trait modifies every tool. -->
  <!-- EN: melee -->
  <UMW_TraitStat_AllTools>近接</UMW_TraitStat_AllTools>

  <!-- EN: {0} damage -->
  <UMW_TraitStat_ToolDamage>{0}攻撃のダメージ</UMW_TraitStat_ToolDamage>

  <!-- EN: {0} armor penetration -->
  <UMW_TraitStat_ToolArmorPenetration>{0}攻撃のアーマー貫通力</UMW_TraitStat_ToolArmorPenetration>

  <!-- EN: min. {0} -->
  <UMW_TraitStat_Minimum>最低{0}</UMW_TraitStat_Minimum>

  <!-- EN: min. {0} at normal quality, rising with quality -->
  <UMW_TraitStat_QualityMinimum>最低{0}（標準品の場合）、品質が上がるほど上昇</UMW_TraitStat_QualityMinimum>
  <!-- EN: min. {0} mm RHA at normal quality, rising with quality -->
  <UMW_TraitStat_QualityMinimumSharpCE>最低{0} mm RHA（標準品の場合）、品質が上がるほど上昇</UMW_TraitStat_QualityMinimumSharpCE>
  <!-- EN: min. {0} MPa at normal quality, rising with quality -->
  <UMW_TraitStat_QualityMinimumBluntCE>最低{0} MPa（標準品の場合）、品質が上がるほど上昇</UMW_TraitStat_QualityMinimumBluntCE>
  <!-- EN: {0}: sharp penetration raised to {1} mm RHA by the {2} trait -->
  <UMW_CETooltip_FloorSharp>{0}：武器の特性「{2}」により、鋭利な攻撃の貫通力が{1} mm RHAに上昇</UMW_CETooltip_FloorSharp>
  <!-- EN: {0}: blunt penetration raised to {1} MPa by the {2} trait -->
  <UMW_CETooltip_FloorBlunt>{0}：武器の特性「{2}」により、鈍器の貫通力が{1} MPaに上昇</UMW_CETooltip_FloorBlunt>

  <!-- Rerouted base hit. {0} is the injury hediff's label; the bleed clause is appended in
       parentheses when the new wound bleeds at a different rate than the one it replaces. -->
  <!-- EN: Wound type: {0} -->
  <UMW_TraitStat_WoundType>傷の種類: {0}</UMW_TraitStat_WoundType>

  <!-- EN: bleed rate {0} -->
  <UMW_TraitStat_BleedRate>出血量 {0}</UMW_TraitStat_BleedRate>

  <!-- EN: Stabs strike internal organs {0} of the time -->
  <UMW_TraitStat_ForcedInternal>刺突が{0}の確率で内臓に達する</UMW_TraitStat_ForcedInternal>

  <!-- On-hit effects. {0} (or {1}) is one of the effect clauses below; the chance form is used
       whenever the effect can fail to proc. -->
  <!-- EN: On hit: {0} -->
  <UMW_TraitStat_OnHit>命中時: {0}</UMW_TraitStat_OnHit>

  <!-- EN: On hit ({0}): {1} -->
  <UMW_TraitStat_OnHitChance>命中時({0}): {1}</UMW_TraitStat_OnHitChance>

  <!-- EN: {0} {1} damage -->
  <UMW_TraitStat_ExtraDamage>{1}ダメージ {0}</UMW_TraitStat_ExtraDamage>

  <!-- EN: {0} {1} damage, {2} armor penetration -->
  <UMW_TraitStat_ExtraDamageAP>{1}ダメージ {0}, アーマー貫通力 {2}</UMW_TraitStat_ExtraDamageAP>

  <!-- EN: {0} {1} damage, not reduced by armor -->
  <UMW_TraitStat_ExtraDamageIgnoreArmor>{1}ダメージ {0}, アーマーで軽減されない</UMW_TraitStat_ExtraDamageIgnoreArmor>

  <!-- What an extra-damage payload leaves behind, derived from its DamageDef and wrapped around
       the damage clause above, which is {0}. In the first key {1} is a comma list of the hediffs
       the damage applies on top of the wound (vanilla Envenomed's "toxic buildup", Opiated's
       "sedative buildup"); in the second it is the injury's own labelNoun, used only when the
       wound is a modded one rather than one of the game's injuries (under Combat Extended,
       Envenomed's "a venomous stab wound"). -->
  <!-- EN: {0}, applies {1} -->
  <UMW_TraitStat_ExtraDamageApplies>{0}, 付与: {1}</UMW_TraitStat_ExtraDamageApplies>

  <!-- EN: {0}, leaving {1} -->
  <UMW_TraitStat_ExtraDamageWound>{0}, {1}を残す</UMW_TraitStat_ExtraDamageWound>

  <!-- EN: stun for {0} -->
  <UMW_TraitStat_Stun>{0}スタンさせる</UMW_TraitStat_Stun>

  <!-- EN: stagger for {0} ({1} move speed) -->
  <UMW_TraitStat_Stagger>{0}よろめかせる(移動速度 {1})</UMW_TraitStat_Stagger>

  <!-- EN: {0} (flesh only) -->
  <UMW_TraitStat_FleshOnly>{0}(生身の相手のみ)</UMW_TraitStat_FleshOnly>

  <!-- EN: {0} (humanlikes only) -->
  <UMW_TraitStat_HumanlikeOnly>{0}(人型のみ)</UMW_TraitStat_HumanlikeOnly>

  <!-- Wielder-side stat effect. {0} is a stat line or, for a hediff with no stat modifiers, the
       hediff's own label. -->
  <!-- EN: {0} (wielder) -->
  <UMW_TraitStat_Wielder>{0}(使用者)</UMW_TraitStat_Wielder>

  <!-- Defender-side parry. {0} is the parry chance. -->
  <!-- EN: {0} chance to parry melee attacks -->
  <UMW_TraitStat_Parry>近接攻撃を{0}の確率で受け流す</UMW_TraitStat_Parry>

  <!-- Ability granted by the trait. {0} is the AbilityDef's label. -->
  <!-- EN: Grants ability: {0} -->
  <UMW_TraitStat_GrantsAbility>能力を付与: 「{0}」</UMW_TraitStat_GrantsAbility>

  <!-- Forced art inscription: the weapon always carries an art title and description, regardless
       of quality. -->
  <!-- EN: Always bears an art inscription -->
  <UMW_TraitStat_ForcedArt>常に芸術品としての銘を持つ</UMW_TraitStat_ForcedArt>

</LanguageData>
