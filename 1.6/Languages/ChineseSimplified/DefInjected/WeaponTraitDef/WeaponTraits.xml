  <!-- EN: ornamental -->
  <UMW_Ornamental.traitAdjectives.2>装饰</UMW_Ornamental.traitAdjectives.2>


  <!-- EN: piledriver -->
  <UMW_Piledriver.label>打桩头</UMW_Piledriver.label>

  <!-- EN: The head is built as a piledriver. The wielder can drive it into the ground to stun those around them, but the mechanism needs time to reset after each use. -->
  <UMW_Piledriver.description>锤头采用打桩机结构。使用者可以把它砸进地面，击晕周围的人，但机构每次使用后都需要时间复位。</UMW_Piledriver.description>

  <!-- EN: piledriving -->
  <UMW_Piledriver.traitAdjectives.0>打桩</UMW_Piledriver.traitAdjectives.0>

  <!-- EN: earthshaking -->
  <UMW_Piledriver.traitAdjectives.1>撼地</UMW_Piledriver.traitAdjectives.1>

  <!-- EN: quaking -->
  <UMW_Piledriver.traitAdjectives.2>震颤</UMW_Piledriver.traitAdjectives.2>

  <!-- EN: thunderous -->
  <UMW_Piledriver.traitAdjectives.3>雷鸣</UMW_Piledriver.traitAdjectives.3>

  <!-- EN: charge -->
  <UMW_Piledriver.abilityProps.chargeNoun>充能</UMW_Piledriver.abilityProps.chargeNoun>

  <!-- EN: on cooldown -->
  <UMW_Piledriver.abilityProps.cooldownGerund>冷却中</UMW_Piledriver.abilityProps.cooldownGerund>


  <!-- EN: quilloned -->
  <UMW_Quilloned.label>十字剑格</UMW_Quilloned.label>

  <!-- EN: Quillons flare wide from the hilt, letting the wielder catch incoming blows and turn them aside. -->
  <UMW_Quilloned.description>剑格自剑柄向两侧大幅张开，让持有者得以架住来袭的攻击并将其荡开。</UMW_Quilloned.description>

  <!-- EN: quilloned -->
  <UMW_Quilloned.traitAdjectives.0>宽格</UMW_Quilloned.traitAdjectives.0>

  <!-- EN: cross-guarded -->
  <UMW_Quilloned.traitAdjectives.1>十字格</UMW_Quilloned.traitAdjectives.1>

  <!-- EN: warding -->
  <UMW_Quilloned.traitAdjectives.2>守御</UMW_Quilloned.traitAdjectives.2>


  <!-- EN: razored -->
  <UMW_Razored.label>剃刀刃</UMW_Razored.label>

  <!-- EN: The edge is honed to a keen razor that bites deeper and drives cleanly through armor. -->
  <UMW_Razored.description>刃口被研磨得如剃刀般锋利，切入更深，还能干净利落地穿透护甲。</UMW_Razored.description>

  <!-- EN: razored -->
  <UMW_Razored.traitAdjectives.0>剃刀</UMW_Razored.traitAdjectives.0>

  <!-- EN: razor-sharp -->
  <UMW_Razored.traitAdjectives.1>锋锐</UMW_Razored.traitAdjectives.1>

  <!-- EN: keen -->
  <UMW_Razored.traitAdjectives.2>锐利</UMW_Razored.traitAdjectives.2>


  <!-- EN: serrated -->
  <UMW_Serrated.label>锯齿刃</UMW_Serrated.label>

  <!-- EN: The edge is cut into vicious teeth that tear ragged, freely bleeding wounds, though they slash a little shallower than a clean edge. On a thrust the same teeth catch and rip flesh as the blade is drawn back. -->
  <UMW_Serrated.description>刃口被开出凶恶的锯齿，会撕出参差不齐、血流不止的伤口，只是砍切深度略逊于平整的刃口。突刺时，这些锯齿同样会在刀身抽回时钩住并撕裂血肉。</UMW_Serrated.description>

  <!-- EN: serrated -->
  <UMW_Serrated.traitAdjectives.0>锯齿</UMW_Serrated.traitAdjectives.0>

  <!-- EN: jagged -->
  <UMW_Serrated.traitAdjectives.1>獠牙</UMW_Serrated.traitAdjectives.1>

  <!-- EN: vicious -->
  <UMW_Serrated.traitAdjectives.2>凶残</UMW_Serrated.traitAdjectives.2>

  <!-- EN: sawtooth -->
  <UMW_Serrated.traitAdjectives.3>锯牙</UMW_Serrated.traitAdjectives.3>


  <!-- EN: storied -->
  <UMW_Storied.label>传世</UMW_Storied.label>

  <!-- EN: This weapon has a name and a history, and the deeds of those who carried it are remembered. The wielder can use it to rally nearby allies, but only once every few days. -->
  <UMW_Storied.description>该武器有自己的名字和来历，历代持有者的事迹至今仍被人们铭记。使用者可以用它鼓舞附近的盟友，但每隔几天才能用一次。</UMW_Storied.description>

  <!-- EN: storied -->
  <UMW_Storied.traitAdjectives.0>传世</UMW_Storied.traitAdjectives.0>

