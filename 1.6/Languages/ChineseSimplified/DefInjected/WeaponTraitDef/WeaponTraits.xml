  <!-- EN: cruel -->
  <UMW_Studded.traitAdjectives.2>残酷</UMW_Studded.traitAdjectives.2>


  <!-- EN: ugly -->
  <UMW_Ugly.label>丑陋</UMW_Ugly.label>

  <!-- EN: This weapon was crafted with no respect for aesthetics. It looks like junk but gets the job done. Traders will pay less for it. -->
  <UMW_Ugly.description>该武器毫不讲究美观，形似废品却依然能用。商人会压价收购。</UMW_Ugly.description>

