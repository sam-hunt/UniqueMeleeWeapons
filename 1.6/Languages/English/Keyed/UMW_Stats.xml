<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- Info card: the per-trait effect lines added to vanilla's "Weapon traits" entry by
       Source/1.6/Traits/TraitEffectSummary.cs. Each renders as one " - ..." line under its trait,
       matching the format vanilla uses for a trait's own statOffsets/statFactors. Keep them short —
       the entry lists up to three traits at once. -->

  <!-- Per-tool damage / armor penetration. {0} is a tool capacity ("cut", "cut and stab") or the
       UMW_TraitStat_AllTools word when the trait modifies every tool. -->
  <UMW_TraitStat_AllTools>melee</UMW_TraitStat_AllTools>
  <UMW_TraitStat_ToolDamage>{0} damage</UMW_TraitStat_ToolDamage>
  <UMW_TraitStat_ToolArmorPenetration>{0} armor penetration</UMW_TraitStat_ToolArmorPenetration>
  <UMW_TraitStat_Minimum>min. {0}</UMW_TraitStat_Minimum>
  <!-- Quality-scaled floor (MeleeToolMod.armorPenetrationQualityFloor): {0} is the floor at normal
       quality; the weapon's own quality multiplies it the way it multiplies any tool's listed
       armor penetration. -->
  <UMW_TraitStat_QualityMinimum>min. {0} at normal quality, rising with quality</UMW_TraitStat_QualityMinimum>
  <!-- The same floor in Combat Extended's units (MeleeToolMod.ceArmorPenetrationSharpQualityFloor /
       ceArmorPenetrationBluntQualityFloor, set only by the CE compat root's trait patch, so these
       lines never show without Combat Extended). {0} is a plain number; the unit is CE's own: sharp
       penetration in millimetres of rolled homogeneous armour, blunt in megapascals. Our own keys
       rather than CE's CE_mmRHA / CE_MPa so no text couples to a foreign Keyed file. -->
  <UMW_TraitStat_QualityMinimumSharpCE>min. {0} mm RHA at normal quality, rising with quality</UMW_TraitStat_QualityMinimumSharpCE>
  <UMW_TraitStat_QualityMinimumBluntCE>min. {0} MPa at normal quality, rising with quality</UMW_TraitStat_QualityMinimumBluntCE>

  <!-- Rerouted base hit. {0} is the injury hediff's label; the bleed clause is appended in
       parentheses when the new wound bleeds at a different rate than the one it replaces. The
       forced-internal line states the rerouted damage's stabChanceOfForcedInternal (vanilla stabs
       roll 60%), shown when the conversion changes it. -->
  <UMW_TraitStat_WoundType>Wound type: {0}</UMW_TraitStat_WoundType>
  <UMW_TraitStat_BleedRate>bleed rate {0}</UMW_TraitStat_BleedRate>
  <UMW_TraitStat_ForcedInternal>Stabs strike internal organs {0} of the time</UMW_TraitStat_ForcedInternal>

  <!-- On-hit effects. {0} (or {1}) is one of the effect clauses below; the chance form is used
       whenever the effect can fail to proc. -->
  <UMW_TraitStat_OnHit>On hit: {0}</UMW_TraitStat_OnHit>
  <UMW_TraitStat_OnHitChance>On hit ({0}): {1}</UMW_TraitStat_OnHitChance>
  <UMW_TraitStat_ExtraDamage>{0} {1} damage</UMW_TraitStat_ExtraDamage>
  <UMW_TraitStat_ExtraDamageAP>{0} {1} damage, {2} armor penetration</UMW_TraitStat_ExtraDamageAP>
  <UMW_TraitStat_ExtraDamageIgnoreArmor>{0} {1} damage, not reduced by armor</UMW_TraitStat_ExtraDamageIgnoreArmor>
  <!-- What an extra-damage payload leaves behind, derived from its DamageDef and wrapped around
       the damage clause above, which is {0}. In the first key {1} is a comma list of the hediffs
       the damage applies on top of the wound (vanilla Envenomed's "toxic buildup", Opiated's
       "sedative buildup"); in the second it is the injury's own labelNoun, used only when the
       wound is a modded one rather than one of the game's injuries (under Combat Extended,
       Envenomed's "a venomous stab wound"). -->
  <UMW_TraitStat_ExtraDamageApplies>{0}, applies {1}</UMW_TraitStat_ExtraDamageApplies>
  <UMW_TraitStat_ExtraDamageWound>{0}, leaving {1}</UMW_TraitStat_ExtraDamageWound>
  <UMW_TraitStat_Stun>stun for {0}</UMW_TraitStat_Stun>
  <UMW_TraitStat_Stagger>stagger for {0} ({1} move speed)</UMW_TraitStat_Stagger>
  <UMW_TraitStat_FleshOnly>{0} (flesh only)</UMW_TraitStat_FleshOnly>
  <UMW_TraitStat_HumanlikeOnly>{0} (humanlikes only)</UMW_TraitStat_HumanlikeOnly>

  <!-- Wielder-side stat effect, carried by an equipped hediff on the trait (the one vanilla-applied
       wielder-side vehicle; unused by design, kept as the escape hatch — see 1.6/Defs/CLAUDE.md). {0} is a
       stat line or, for a hediff with no stat modifiers, the hediff's own label. The stat line is
       rendered unfinalized, so a stat with a postProcessCurve shows its raw offset rather than a
       percentage (the way vanilla shows Nimble's +15). -->
  <UMW_TraitStat_Wielder>{0} (wielder)</UMW_TraitStat_Wielder>

  <!-- Defender-side parry (MeleeParryExtension). {0} is the parry chance. -->
  <UMW_TraitStat_Parry>{0} chance to parry melee attacks</UMW_TraitStat_Parry>

  <!-- Ability granted by the trait. {0} is the AbilityDef's label. -->
  <UMW_TraitStat_GrantsAbility>Grants ability: {0}</UMW_TraitStat_GrantsAbility>

  <!-- Forced art inscription (ForcedArtExtension): the weapon always carries an art title and
       description, regardless of quality. -->
  <UMW_TraitStat_ForcedArt>Always bears an art inscription</UMW_TraitStat_ForcedArt>

</LanguageData>
