  <!-- EN: warband -->
  <UMW_Warband.label>bando de guerra</UMW_Warband.label>

  <!-- EN: A roving band of tribal fighters who live by raiding, preying on the settlements and travelers around them. -->
  <UMW_Warband.description>Um bando errante de guerreiros tribais que vive de invasões e ataca os assentamentos e viajantes da região.</UMW_Warband.description>

  <!-- EN: warrior -->
  <UMW_Warband.pawnSingular>guerreiro</UMW_Warband.pawnSingular>

  <!-- EN: warriors -->
  <UMW_Warband.pawnsPlural>guerreiros</UMW_Warband.pawnsPlural>

  <!-- EN: warlord -->
  <UMW_Warband.leaderTitle>senhor da guerra</UMW_Warband.leaderTitle>

  <!-- EN: {0} from {1} are attacking your {2}. -->
  <UMW_Warband.messageDefendersAttacking>{0} de {1} estão atacando seu {2}.</UMW_Warband.messageDefendersAttacking>

