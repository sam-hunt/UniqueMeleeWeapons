  <!-- EN: violet-sheened -->
  <UMW_Enameled.traitAdjectives.2>лиловый</UMW_Enameled.traitAdjectives.2>


  <!-- EN: envenomed -->
  <UMW_Envenomed.label>отравленное</UMW_Envenomed.label>

  <!-- EN: The point is coated in a slow neurotoxic venom that poisons those it wounds. -->
  <UMW_Envenomed.description>Остриё покрыто медленно действующим нейротоксичным ядом, который отравляет тех, кого ранит.</UMW_Envenomed.description>

