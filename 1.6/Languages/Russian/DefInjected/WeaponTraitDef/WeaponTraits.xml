  <!-- EN: numbing -->
  <UMW_Opiated.traitAdjectives.3>дурманящий</UMW_Opiated.traitAdjectives.3>


  <!-- EN: ornamental -->
  <UMW_Ornamental.label>декоративное</UMW_Ornamental.label>

  <!-- EN: This weapon was crafted for aesthetics over functionality. It deals less damage but looks great. -->
  <UMW_Ornamental.description>Это оружие создано скорее ради красоты, чем ради эффективности. Наносит меньше урона, но выглядит потрясающе.</UMW_Ornamental.description>

  <!-- EN: beautiful -->
