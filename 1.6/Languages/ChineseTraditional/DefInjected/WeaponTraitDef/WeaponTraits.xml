  <!-- EN: hypodermic -->
  <UMW_NeedlePoint.traitAdjectives.2>錐心</UMW_NeedlePoint.traitAdjectives.2>


  <!-- EN: opiated -->
  <UMW_Opiated.label>鴉片塗層</UMW_Opiated.label>

  <!-- EN: The point is coated in a potent opiate that builds in the blood with each hit, eventually rendering the victim unconscious. -->
  <UMW_Opiated.description>尖端塗有強效鴉片類藥物，每次命中都會使其在血液中累積，最終令受害者失去知覺。</UMW_Opiated.description>

  <!-- EN: opiated -->
