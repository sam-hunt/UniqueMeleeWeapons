<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: armor spike -->
  <UMW_ArmorSpike.label>pico perforante</UMW_ArmorSpike.label>

  <!-- EN: The point is reinforced into a heavy armor-piercing spike that punches through plate and carapace. -->
  <UMW_ArmorSpike.description>La punta está reforzada hasta formar un pico macizo y perforante que atraviesa placas de armadura y caparazones.</UMW_ArmorSpike.description>

  <!-- EN: lancing -->
  <UMW_ArmorSpike.traitAdjectives.0>punzante</UMW_ArmorSpike.traitAdjectives.0>

  <!-- EN: armorbane -->
  <UMW_ArmorSpike.traitAdjectives.1>rompearmaduras</UMW_ArmorSpike.traitAdjectives.1>

  <!-- EN: punching -->
  <UMW_ArmorSpike.traitAdjectives.2>perforante</UMW_ArmorSpike.traitAdjectives.2>


  <!-- EN: barbed -->
  <UMW_Barbed.label>con lengüetas</UMW_Barbed.label>

  <!-- EN: Barbs behind the point catch in the wound and tear it wider as the weapon is drawn back out. -->
  <UMW_Barbed.description>Unas lengüetas situadas detrás de la punta se enganchan en la herida y la desgarran más al retirar el arma.</UMW_Barbed.description>

  <!-- EN: barbed -->
  <UMW_Barbed.traitAdjectives.0>de lengüetas</UMW_Barbed.traitAdjectives.0>

  <!-- EN: hooked -->
  <UMW_Barbed.traitAdjectives.1>de garfio</UMW_Barbed.traitAdjectives.1>

  <!-- EN: cruel -->
  <UMW_Barbed.traitAdjectives.2>cruel</UMW_Barbed.traitAdjectives.2>


  <!-- EN: bell-cast -->
  <UMW_BellCast.label>fundido en campana</UMW_BellCast.label>

  <!-- EN: The head is cast solid like a bell. A clean strike rings through armor and bone, briefly stunning the target. -->
  <UMW_BellCast.description>La cabeza está fundida en una sola pieza, como una campana. Un golpe limpio hace vibrar la armadura y el hueso, y aturde brevemente al objetivo.</UMW_BellCast.description>

  <!-- EN: bell-cast -->
  <UMW_BellCast.traitAdjectives.0>de fundición de campana</UMW_BellCast.traitAdjectives.0>

  <!-- EN: ringing -->
  <UMW_BellCast.traitAdjectives.1>resonante</UMW_BellCast.traitAdjectives.1>

  <!-- EN: resonant -->
  <UMW_BellCast.traitAdjectives.2>de eco profundo</UMW_BellCast.traitAdjectives.2>


  <!-- EN: blood-stained -->
  <UMW_BloodStained.label>manchado de sangre</UMW_BloodStained.label>

  <!-- EN: This weapon is caked in layers of dark, dried blood. The sight of it can send the people it wounds fleeing in panic. Carrying something so grisly weighs on most people, though a few relish it. Traders will pay less for it. -->
  <UMW_BloodStained.description>Esta arma está cubierta de capas de sangre oscura y reseca. Su aspecto puede hacer que las personas a las que hiere huyan presas del pánico. Llevar encima algo tan macabro afecta al ánimo de la mayoría, aunque unos pocos lo disfrutan. Los comerciantes pagarán menos por ella.</UMW_BloodStained.description>

  <!-- EN: blood-stained -->
  <UMW_BloodStained.traitAdjectives.0>con manchas de sangre</UMW_BloodStained.traitAdjectives.0>

  <!-- EN: bloody -->
  <UMW_BloodStained.traitAdjectives.1>de sangre</UMW_BloodStained.traitAdjectives.1>

  <!-- EN: gory -->
  <UMW_BloodStained.traitAdjectives.2>de sangre coagulada</UMW_BloodStained.traitAdjectives.2>

  <!-- EN: sanguine -->
  <UMW_BloodStained.traitAdjectives.3>de rojo sangre</UMW_BloodStained.traitAdjectives.3>


  <!-- EN: carbonized -->
  <UMW_Carbonized.label>carbonizado</UMW_Carbonized.label>

  <!-- EN: This weapon has been through fire. Its charred surface is hardened by the heat and will not easily burn again. It hits a little harder than normal, but the scorched body is brittle and wears out faster. -->
  <UMW_Carbonized.description>Esta arma ha pasado por el fuego. Su superficie carbonizada ha quedado endurecida por el calor y no volverá a arder con facilidad. Golpea con algo más de fuerza de lo normal, pero al estar chamuscada es más frágil y se deteriora más rápido.</UMW_Carbonized.description>

  <!-- EN: carbonized -->
  <UMW_Carbonized.traitAdjectives.0>de superficie carbonizada</UMW_Carbonized.traitAdjectives.0>

  <!-- EN: fire-blackened -->
  <UMW_Carbonized.traitAdjectives.1>de negrura de fuego</UMW_Carbonized.traitAdjectives.1>

  <!-- EN: charred -->
  <UMW_Carbonized.traitAdjectives.2>de brasa</UMW_Carbonized.traitAdjectives.2>

  <!-- EN: soot-stained -->
  <UMW_Carbonized.traitAdjectives.3>de hollín</UMW_Carbonized.traitAdjectives.3>


  <!-- EN: counterweighted -->
  <UMW_Counterweighted.label>contrapesado</UMW_Counterweighted.label>

  <!-- EN: A counterweight balances the heft, making the weapon quicker to recover between swings at a slight cost to power. -->
  <UMW_Counterweighted.description>Un contrapeso compensa la masa del arma, que se recupera más rápido entre golpes a cambio de una ligera pérdida de potencia.</UMW_Counterweighted.description>

  <!-- EN: balanced -->
  <UMW_Counterweighted.traitAdjectives.0>de equilibrio perfecto</UMW_Counterweighted.traitAdjectives.0>

  <!-- EN: swift -->
  <UMW_Counterweighted.traitAdjectives.1>de manejo veloz</UMW_Counterweighted.traitAdjectives.1>


  <!-- EN: cumbersome -->
  <UMW_Cumbersome.label>torpe</UMW_Cumbersome.label>

  <!-- EN: This weapon is unwieldy to use, making it slower to swing. -->
  <UMW_Cumbersome.description>Esta arma es difícil de manejar, lo que la hace más lenta para golpear.</UMW_Cumbersome.description>

  <!-- EN: cumbersome -->
  <UMW_Cumbersome.traitAdjectives.0>torpe</UMW_Cumbersome.traitAdjectives.0>

  <!-- EN: bulky -->
  <UMW_Cumbersome.traitAdjectives.1>de gran tamaño</UMW_Cumbersome.traitAdjectives.1>

  <!-- EN: ungainly -->
  <UMW_Cumbersome.traitAdjectives.2>de manejo torpe</UMW_Cumbersome.traitAdjectives.2>


  <!-- EN: dead-blow -->
  <UMW_DeadBlow.label>sin rebote</UMW_DeadBlow.label>

  <!-- EN: The hollow head is filled with loose shot that slams forward on impact, so none of the blow's force bounces back. Targets it strikes will stagger, even when the blow does not drop them. -->
  <UMW_DeadBlow.description>La cabeza hueca está rellena de perdigones sueltos que se desplazan hacia delante al impactar, de modo que la fuerza del golpe no rebota. Los objetivos a los que alcanza se tambalearán, incluso cuando el golpe no los derribe.</UMW_DeadBlow.description>

  <!-- EN: dead-blow -->
  <UMW_DeadBlow.traitAdjectives.0>sin rebote</UMW_DeadBlow.traitAdjectives.0>

  <!-- EN: shot-filled -->
  <UMW_DeadBlow.traitAdjectives.1>de relleno de perdigones</UMW_DeadBlow.traitAdjectives.1>

  <!-- EN: battering -->
  <UMW_DeadBlow.traitAdjectives.2>de ariete</UMW_DeadBlow.traitAdjectives.2>


  <!-- EN: enameled -->
  <UMW_Enameled.label>esmaltado</UMW_Enameled.label>

  <!-- EN: A vitreous enamel has been fired and fused over the body of this weapon, glazing it in a deep, glossy violet. Traders will pay more for it. -->
  <UMW_Enameled.description>Sobre el cuerpo de esta arma se ha cocido y fundido un esmalte vítreo que la vidria de un violeta profundo y brillante. Los comerciantes pagarán más por ella.</UMW_Enameled.description>

  <!-- EN: enameled -->
  <UMW_Enameled.traitAdjectives.0>de esmalte</UMW_Enameled.traitAdjectives.0>

  <!-- EN: glazed -->
  <UMW_Enameled.traitAdjectives.1>de vidriado</UMW_Enameled.traitAdjectives.1>

  <!-- EN: violet-sheened -->
  <UMW_Enameled.traitAdjectives.2>de brillo violeta</UMW_Enameled.traitAdjectives.2>


  <!-- EN: envenomed -->
  <UMW_Envenomed.label>envenenado</UMW_Envenomed.label>

  <!-- EN: The point is coated in a slow neurotoxic venom that poisons those it wounds. -->
  <UMW_Envenomed.description>La punta está recubierta de un veneno neurotóxico de acción lenta que envenena a quienes hiere.</UMW_Envenomed.description>

  <!-- EN: envenomed -->
  <UMW_Envenomed.traitAdjectives.0>de veneno</UMW_Envenomed.traitAdjectives.0>

  <!-- EN: venomous -->
  <UMW_Envenomed.traitAdjectives.1>de ponzoña</UMW_Envenomed.traitAdjectives.1>

  <!-- EN: poisoned -->
  <UMW_Envenomed.traitAdjectives.2>con veneno</UMW_Envenomed.traitAdjectives.2>

  <!-- EN: toxic -->
  <UMW_Envenomed.traitAdjectives.3>de toxina</UMW_Envenomed.traitAdjectives.3>


  <!-- EN: flanged -->
  <UMW_Flanged.label>de aletas</UMW_Flanged.label>

  <!-- EN: The head is ridged with flanges that concentrate the force of a blow into a narrow edge, cracking armor plate rather than denting it. -->
  <UMW_Flanged.description>La cabeza tiene unas aletas en relieve que concentran la fuerza del golpe en un borde estrecho y resquebrajan las placas de armadura en lugar de abollarlas.</UMW_Flanged.description>

  <!-- EN: flanged -->
  <UMW_Flanged.traitAdjectives.0>de aletas</UMW_Flanged.traitAdjectives.0>

  <!-- EN: riving -->
  <UMW_Flanged.traitAdjectives.1>de aletas hendedoras</UMW_Flanged.traitAdjectives.1>

  <!-- EN: armor-cracking -->
  <UMW_Flanged.traitAdjectives.2>rompearmaduras</UMW_Flanged.traitAdjectives.2>


  <!-- EN: gold inlay -->
  <UMW_GoldInlay.label>incrustación de oro</UMW_GoldInlay.label>

  <!-- EN: This weapon is inlaid with gold. Traders will pay more for it. -->
  <UMW_GoldInlay.description>Esta arma tiene incrustaciones de oro. Los comerciantes pagarán más por ella.</UMW_GoldInlay.description>

  <!-- EN: gold -->
  <UMW_GoldInlay.traitAdjectives.0>de oro</UMW_GoldInlay.traitAdjectives.0>

  <!-- EN: golden -->
  <UMW_GoldInlay.traitAdjectives.1>brillante</UMW_GoldInlay.traitAdjectives.1>


  <!-- EN: head-weighted -->
  <UMW_HeadWeighted.label>de cabeza pesada</UMW_HeadWeighted.label>

  <!-- EN: The weight is gathered toward the striking end, so each swing lands harder but is slower to recover. -->
  <UMW_HeadWeighted.description>El peso se concentra en el extremo que golpea, de modo que cada golpe cae con más fuerza, pero el arma tarda más en recuperarse.</UMW_HeadWeighted.description>

  <!-- EN: devastating -->
  <UMW_HeadWeighted.traitAdjectives.0>de golpe devastador</UMW_HeadWeighted.traitAdjectives.0>

  <!-- EN: mighty -->
  <UMW_HeadWeighted.traitAdjectives.1>de gran potencia</UMW_HeadWeighted.traitAdjectives.1>

  <!-- EN: ponderous -->
  <UMW_HeadWeighted.traitAdjectives.2>de peso considerable</UMW_HeadWeighted.traitAdjectives.2>


  <!-- EN: jade inlay -->
  <UMW_JadeInlay.label>incrustación de jade</UMW_JadeInlay.label>

  <!-- EN: This weapon is adorned with jade. Traders will pay more for it. -->
  <UMW_JadeInlay.description>Esta arma está adornada con jade. Los comerciantes pagarán más por ella.</UMW_JadeInlay.description>

  <!-- EN: jade -->
  <UMW_JadeInlay.traitAdjectives.0>de jade</UMW_JadeInlay.traitAdjectives.0>


  <!-- EN: lightweight -->
  <UMW_Lightweight.label>ligero</UMW_Lightweight.label>

  <!-- EN: This weapon is much lighter than normal, quickening its swing. -->
  <UMW_Lightweight.description>Esta arma es mucho más ligera de lo normal, acelerando sus golpes.</UMW_Lightweight.description>

  <!-- EN: light -->
  <UMW_Lightweight.traitAdjectives.0>ágil</UMW_Lightweight.traitAdjectives.0>

  <!-- EN: nimble -->
  <UMW_Lightweight.traitAdjectives.1>grácil</UMW_Lightweight.traitAdjectives.1>

  <!-- EN: quickdraw -->
  <UMW_Lightweight.traitAdjectives.2>veloz</UMW_Lightweight.traitAdjectives.2>


  <!-- EN: needle point -->
  <UMW_NeedlePoint.label>punta de aguja</UMW_NeedlePoint.label>

  <!-- EN: The point is tapered to a fine needle that slips past bone and muscle to reach the organs beneath. Placing it cleanly takes slower, more deliberate thrusts. -->
  <UMW_NeedlePoint.description>La punta se estrecha hasta formar una aguja fina que se cuela entre el hueso y el músculo para alcanzar los órganos que hay debajo. Clavarla con precisión requiere estocadas más lentas y pausadas.</UMW_NeedlePoint.description>

  <!-- EN: needle -->
  <UMW_NeedlePoint.traitAdjectives.0>de aguja</UMW_NeedlePoint.traitAdjectives.0>

  <!-- EN: needling -->
  <UMW_NeedlePoint.traitAdjectives.1>de picadura</UMW_NeedlePoint.traitAdjectives.1>

  <!-- EN: hypodermic -->
  <UMW_NeedlePoint.traitAdjectives.2>de jeringa</UMW_NeedlePoint.traitAdjectives.2>


  <!-- EN: opiated -->
  <UMW_Opiated.label>opiáceo</UMW_Opiated.label>

  <!-- EN: The point is coated in a potent opiate that builds in the blood with each hit, eventually rendering the victim unconscious. -->
  <UMW_Opiated.description>La punta está recubierta de un opiáceo potente que se acumula en la sangre con cada impacto y acaba dejando inconsciente a la víctima.</UMW_Opiated.description>

  <!-- EN: opiated -->
  <UMW_Opiated.traitAdjectives.0>de opiáceo</UMW_Opiated.traitAdjectives.0>

  <!-- EN: sedative -->
  <UMW_Opiated.traitAdjectives.1>de sedante</UMW_Opiated.traitAdjectives.1>

  <!-- EN: soporific -->
  <UMW_Opiated.traitAdjectives.2>de somnífero</UMW_Opiated.traitAdjectives.2>

  <!-- EN: numbing -->
  <UMW_Opiated.traitAdjectives.3>de adormecimiento</UMW_Opiated.traitAdjectives.3>


  <!-- EN: ornamental -->
  <UMW_Ornamental.label>ornamental</UMW_Ornamental.label>

  <!-- EN: This weapon was crafted for aesthetics over functionality. It deals less damage but looks great. -->
  <UMW_Ornamental.description>Esta arma fue fabricada con la estética por encima de la funcionalidad. Hace menos daño, pero tiene muy buen aspecto.</UMW_Ornamental.description>

  <!-- EN: beautiful -->
  <UMW_Ornamental.traitAdjectives.0>de adorno</UMW_Ornamental.traitAdjectives.0>

  <!-- EN: elegant -->
  <UMW_Ornamental.traitAdjectives.1>elegante</UMW_Ornamental.traitAdjectives.1>

  <!-- EN: ornamental -->
  <UMW_Ornamental.traitAdjectives.2>ornamental</UMW_Ornamental.traitAdjectives.2>


  <!-- EN: piledriver -->
  <UMW_Piledriver.label>martinete</UMW_Piledriver.label>

  <!-- EN: The head is built as a piledriver. The wielder can drive it into the ground to stun those around them, but the mechanism needs time to reset after each use. -->
  <UMW_Piledriver.description>La cabeza está construida como un martinete. El usuario puede clavarla en el suelo para aturdir a quienes lo rodean, pero el mecanismo necesita tiempo para rearmarse tras cada uso.</UMW_Piledriver.description>

  <!-- EN: piledriving -->
  <UMW_Piledriver.traitAdjectives.0>de martinete</UMW_Piledriver.traitAdjectives.0>

  <!-- EN: earthshaking -->
  <UMW_Piledriver.traitAdjectives.1>de sacudida telúrica</UMW_Piledriver.traitAdjectives.1>

  <!-- EN: quaking -->
  <UMW_Piledriver.traitAdjectives.2>de temblor</UMW_Piledriver.traitAdjectives.2>

  <!-- EN: thunderous -->
  <UMW_Piledriver.traitAdjectives.3>de trueno</UMW_Piledriver.traitAdjectives.3>

  <!-- EN: charge -->
  <UMW_Piledriver.abilityProps.chargeNoun>carga</UMW_Piledriver.abilityProps.chargeNoun>

  <!-- EN: on cooldown -->
  <UMW_Piledriver.abilityProps.cooldownGerund>en enfriamiento</UMW_Piledriver.abilityProps.cooldownGerund>


  <!-- EN: quilloned -->
  <UMW_Quilloned.label>con gavilanes</UMW_Quilloned.label>

  <!-- EN: Quillons flare wide from the hilt, letting the wielder catch incoming blows and turn them aside. -->
  <UMW_Quilloned.description>Unos gavilanes se abren en ancho desde la empuñadura, lo que permite al usuario detener los golpes entrantes y desviarlos.</UMW_Quilloned.description>

  <!-- EN: quilloned -->
  <UMW_Quilloned.traitAdjectives.0>de gavilanes</UMW_Quilloned.traitAdjectives.0>

  <!-- EN: cross-guarded -->
  <UMW_Quilloned.traitAdjectives.1>de cruz</UMW_Quilloned.traitAdjectives.1>

  <!-- EN: warding -->
  <UMW_Quilloned.traitAdjectives.2>de guarda</UMW_Quilloned.traitAdjectives.2>


  <!-- EN: razored -->
  <UMW_Razored.label>filo de navaja</UMW_Razored.label>

  <!-- EN: The edge is honed to a keen razor that bites deeper and drives cleanly through armor. -->
  <UMW_Razored.description>El filo está afilado hasta quedar como una navaja penetrante que muerde más profundo y atraviesa la armadura con limpieza.</UMW_Razored.description>

  <!-- EN: razored -->
  <UMW_Razored.traitAdjectives.0>de navaja</UMW_Razored.traitAdjectives.0>

  <!-- EN: razor-sharp -->
  <UMW_Razored.traitAdjectives.1>de filo de navaja</UMW_Razored.traitAdjectives.1>

  <!-- EN: keen -->
  <UMW_Razored.traitAdjectives.2>penetrante</UMW_Razored.traitAdjectives.2>


  <!-- EN: serrated -->
  <UMW_Serrated.label>serrado</UMW_Serrated.label>

  <!-- EN: The edge is cut into vicious teeth that tear ragged, freely bleeding wounds, though they slash a little shallower than a clean edge. On a thrust the same teeth catch and rip flesh as the blade is drawn back. -->
  <UMW_Serrated.description>El filo está tallado en dientes brutales que abren heridas desgarradas y de hemorragia abundante, aunque cortan algo menos profundo que un filo limpio. Al estocar, esos mismos dientes se enganchan y desgarran la carne cuando la hoja se retira.</UMW_Serrated.description>

  <!-- EN: serrated -->
  <UMW_Serrated.traitAdjectives.0>de sierra</UMW_Serrated.traitAdjectives.0>

  <!-- EN: jagged -->
  <UMW_Serrated.traitAdjectives.1>de dientes irregulares</UMW_Serrated.traitAdjectives.1>

  <!-- EN: vicious -->
  <UMW_Serrated.traitAdjectives.2>brutal</UMW_Serrated.traitAdjectives.2>

  <!-- EN: sawtooth -->
  <UMW_Serrated.traitAdjectives.3>de dientes de sierra</UMW_Serrated.traitAdjectives.3>


  <!-- EN: storied -->
  <UMW_Storied.label>de renombre</UMW_Storied.label>

  <!-- EN: This weapon has a name and a history, and the deeds of those who carried it are remembered. The wielder can use it to rally nearby allies, but only once every few days. -->
  <UMW_Storied.description>Esta arma tiene nombre e historia, y se recuerdan las hazañas de quienes la portaron. El usuario puede usarla para arengar a los aliados cercanos, pero solo una vez cada pocos días.</UMW_Storied.description>

  <!-- EN: storied -->
  <UMW_Storied.traitAdjectives.0>de renombre</UMW_Storied.traitAdjectives.0>

  <!-- EN: fabled -->
  <UMW_Storied.traitAdjectives.1>de leyenda</UMW_Storied.traitAdjectives.1>

  <!-- EN: ancestral -->
  <UMW_Storied.traitAdjectives.2>ancestral</UMW_Storied.traitAdjectives.2>

  <!-- EN: honored -->
  <UMW_Storied.traitAdjectives.3>de honor</UMW_Storied.traitAdjectives.3>

  <!-- EN: charge -->
  <UMW_Storied.abilityProps.chargeNoun>carga</UMW_Storied.abilityProps.chargeNoun>

  <!-- EN: on cooldown -->
  <UMW_Storied.abilityProps.cooldownGerund>en enfriamiento</UMW_Storied.abilityProps.cooldownGerund>


  <!-- EN: studded -->
  <UMW_Studded.label>con tachuelas</UMW_Studded.label>

  <!-- EN: The head is set with hard studs that concentrate the impact, driving extra force into every blow. -->
  <UMW_Studded.description>La cabeza está claveteada con tachuelas duras que concentran el impacto y añaden fuerza a cada golpe.</UMW_Studded.description>

  <!-- EN: studded -->
  <UMW_Studded.traitAdjectives.0>de tachuelas</UMW_Studded.traitAdjectives.0>

  <!-- EN: knurled -->
  <UMW_Studded.traitAdjectives.1>de moleteado</UMW_Studded.traitAdjectives.1>

  <!-- EN: cruel -->
  <UMW_Studded.traitAdjectives.2>cruel</UMW_Studded.traitAdjectives.2>


  <!-- EN: ugly -->
  <UMW_Ugly.label>feo</UMW_Ugly.label>

  <!-- EN: This weapon was crafted with no respect for aesthetics. It looks like junk but gets the job done. Traders will pay less for it. -->
  <UMW_Ugly.description>Esta arma fue fabricada sin respeto por la estética. Parece chatarra pero cumple con su función. Los comerciantes pagarán menos por ella.</UMW_Ugly.description>

  <!-- EN: crude -->
  <UMW_Ugly.traitAdjectives.0>de aspecto horrible</UMW_Ugly.traitAdjectives.0>

  <!-- EN: ugly -->
  <UMW_Ugly.traitAdjectives.1>horripilante</UMW_Ugly.traitAdjectives.1>

  <!-- EN: monstrous -->
  <UMW_Ugly.traitAdjectives.2>horrible</UMW_Ugly.traitAdjectives.2>

