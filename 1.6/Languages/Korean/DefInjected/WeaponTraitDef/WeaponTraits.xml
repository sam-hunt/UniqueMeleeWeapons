  <!-- EN: hypodermic -->
  <UMW_NeedlePoint.traitAdjectives.2>주사침 같은</UMW_NeedlePoint.traitAdjectives.2>


  <!-- EN: opiated -->
  <UMW_Opiated.label>아편 도포</UMW_Opiated.label>

  <!-- EN: The point is coated in a potent opiate that builds in the blood with each hit, eventually rendering the victim unconscious. -->
  <UMW_Opiated.description>끝부분에 강력한 아편 성분이 발려 있어, 명중할 때마다 혈액에 쌓이다가 결국 대상의 의식을 잃게 합니다.</UMW_Opiated.description>

  <!-- EN: opiated -->
