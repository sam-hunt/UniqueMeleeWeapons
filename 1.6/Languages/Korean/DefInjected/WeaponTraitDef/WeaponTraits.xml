  <!-- EN: toxic -->
  <UMW_Envenomed.traitAdjectives.3>맹독성</UMW_Envenomed.traitAdjectives.3>


  <!-- EN: flanged -->
  <UMW_Flanged.label>날개 돌기</UMW_Flanged.label>

  <!-- EN: The head is ridged with flanges that concentrate the force of a blow into a narrow edge, cracking armor plate rather than denting it. -->
  <UMW_Flanged.description>타격부에 솟은 날개 돌기가 힘을 좁은 모서리에 모아, 갑옷판을 우그러뜨리지 않고 쪼개 버립니다.</UMW_Flanged.description>

  <!-- EN: flanged -->
  <UMW_Flanged.traitAdjectives.0>날개 돌기 달린</UMW_Flanged.traitAdjectives.0>

