  <!-- EN: shot-filled -->
  <UMW_DeadBlow.traitAdjectives.1>납알을 채운</UMW_DeadBlow.traitAdjectives.1>

  <!-- EN: battering -->
  <UMW_DeadBlow.traitAdjectives.2>두들기는</UMW_DeadBlow.traitAdjectives.2>


  <!-- EN: enameled -->
  <UMW_Enameled.label>법랑</UMW_Enameled.label>

  <!-- EN: A vitreous enamel has been fired and fused over the body of this weapon, glazing it in a deep, glossy violet. Traders will pay more for it. -->
  <UMW_Enameled.description>무기 본체에 유리질 법랑을 구워 붙여, 깊고 윤기 있는 보라색 유약을 입혔습니다. 상인들이 더 높은 값을 쳐줍니다.</UMW_Enameled.description>

  <!-- EN: enameled -->
  <UMW_Enameled.traitAdjectives.0>법랑</UMW_Enameled.traitAdjectives.0>

  <!-- EN: glazed -->
