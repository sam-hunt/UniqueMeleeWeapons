  <!-- EN: ungainly -->
  <UMW_Cumbersome.traitAdjectives.2>de maniement pénible</UMW_Cumbersome.traitAdjectives.2>


  <!-- EN: dead-blow -->
  <UMW_DeadBlow.label>sans rebond</UMW_DeadBlow.label>

  <!-- EN: The hollow head is filled with loose shot that slams forward on impact, so none of the blow's force bounces back. Targets it strikes will stagger, even when the blow does not drop them. -->
  <UMW_DeadBlow.description>La tête creuse est remplie de grenaille libre qui se projette vers l'avant à l'impact, si bien que le coup ne rebondit pas. Les cibles frappées tituberont, même si le coup ne les renverse pas.</UMW_DeadBlow.description>

  <!-- EN: dead-blow -->
  <UMW_DeadBlow.traitAdjectives.0>sans rebond</UMW_DeadBlow.traitAdjectives.0>

  <!-- EN: shot-filled -->
