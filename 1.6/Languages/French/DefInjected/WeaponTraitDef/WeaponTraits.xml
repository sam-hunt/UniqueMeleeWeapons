  <!-- EN: carbonized -->
  <UMW_Carbonized.traitAdjectives.0>à surface carbonisée</UMW_Carbonized.traitAdjectives.0>

  <!-- EN: fire-blackened -->
  <UMW_Carbonized.traitAdjectives.1>noir carbone</UMW_Carbonized.traitAdjectives.1>

  <!-- EN: charred -->
  <UMW_Carbonized.traitAdjectives.2>de braise</UMW_Carbonized.traitAdjectives.2>

  <!-- EN: soot-stained -->
  <UMW_Carbonized.traitAdjectives.3>de suie</UMW_Carbonized.traitAdjectives.3>


